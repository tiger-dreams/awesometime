{
  "name": "@jeongpd/awesometime",
  "version": "0.3.0",
  "description": "Pretty, dynamic SVG badges for your GitHub README — progress bars for any period, countdowns, and the classic \"days since\" sign — plus a small library to build your own.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build:action": "ncc build action/index.js -o dist --license licenses.txt"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "svg",
    "badge",
    "readme",
    "github-readme",
    "year-progress",
    "countdown",
    "profile-readme"
  ],
  "author": "tiger-dreams",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tiger-dreams/awesometime.git"
  },
  "homepage": "https://github.com/tiger-dreams/awesometime#readme",
  "bugs": {
    "url": "https://github.com/tiger-dreams/awesometime/issues"
  },
  "files": [
    "lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@actions/core": "^3.0.1",
    "@vercel/ncc": "^0.45.0"
  }
}
